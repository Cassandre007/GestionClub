{
    "name": "cassandre007/gestionclub",
    "description": "Application de gestion de club de théâtre (PHP + Tailwind CSS + DaisyUI)",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "classmap": [
            "src/Model"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "*"
    },
    "scripts": {
        "cs-check": "php-cs-fixer check --diff --verbose",
        "cs-fix": "php-cs-fixer fix --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs-check",
            "@phpstan"
        ]
    }
}
